FROM node:20-alpine AS builder

ARG APP_BASE_PATH=/gestare/
ARG VITE_API_BASE_URL=/gestare-api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx vite build --base="${APP_BASE_PATH}"


FROM nginx:stable-alpine

ARG APP_BASE_PATH=/gestare/
ENV APP_BASE_PATH=$APP_BASE_PATH
ENV NGINX_ENVSUBST_FILTER_VARS=APP_BASE_PATH

RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /tmp/dist
RUN set -e; \
    BASE="${APP_BASE_PATH#/}"; \
    BASE="${BASE%/}"; \
    if [ -z "$BASE" ]; then \
      mv /tmp/dist/* /usr/share/nginx/html/ ; \
    else \
      mkdir -p "/usr/share/nginx/html/$BASE" ; \
      mv /tmp/dist/* "/usr/share/nginx/html/$BASE/" ; \
    fi ; \
    rmdir /tmp/dist

COPY default.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
