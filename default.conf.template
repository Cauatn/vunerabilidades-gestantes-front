server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location ${APP_BASE_PATH} {
        try_files $uri $uri/ ${APP_BASE_PATH}index.html;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|woff2?|ttf|eot|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
